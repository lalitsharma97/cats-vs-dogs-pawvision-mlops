# Add patterns of files dvc should not track
# DVC will ignore these files while tracking data with 'dvc add'

# Models
models/saved_models/*.pkl
models/saved_models/*.pt
models/saved_models/*.h5
models/checkpoints/*

# MLflow
mlruns/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db
